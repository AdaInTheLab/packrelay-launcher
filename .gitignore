/target
Cargo.lock.bak
*.swp
.DS_Store

# Coverage report emitted by `cargo llvm-cov` (CI uploads it to
# Codecov; never committed).
lcov.info

# Editor / IDE
.idea/
.vscode/
*.iml

# Local install/test dirs
/test-install
/scratch

# Tauri updater signing key — the PRIVATE half. Must never be
# committed. The .pub counterpart is safe to commit and goes
# into tauri.conf.json. See docs/UPDATER.md.
tauri-update.key
tauri-update.key.password

# macOS notarization — the base64'd Developer ID Application
# .p12 used to seed the GitHub APPLE_CERTIFICATE secret. Treat
# as the cert itself (which is what it contains). See
# docs/NOTARIZATION.md.
apple-cert.b64.txt
