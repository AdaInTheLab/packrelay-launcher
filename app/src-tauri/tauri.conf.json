{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PackRelay",
  "version": "0.1.5",
  "identifier": "cloud.packrelay.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PackRelay",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzRUU1M0JBQkNBRjBBMDAKUldRQUNxKzh1bFB1azFDQ01JdnNQeVp6Wkg0QlRMbVhmRWQ3QlZDNHpma0dXVUhRVU15djkvU0cK",
      "endpoints": [
        "https://github.com/AdaInTheLab/packrelay-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
